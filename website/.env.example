# ---------------------------------------------------------------------------
# Fiat Law — environment
# Copy to .env.local for development, and set the same keys in the host's
# environment for production. Nothing here has a safe default in production
# except LEADS_DB_PATH.
# ---------------------------------------------------------------------------

# Admin console (/admin) — HTTP Basic auth.
# If ADMIN_PASSWORD is unset, /admin returns 503 in production and is open in
# development. Set a long random password before deploying.
ADMIN_USER=fiat
ADMIN_PASSWORD=

# Where the SQLite lead database lives. Defaults to ./data/leads.db.
# On a platform with an ephemeral filesystem, point this at a mounted volume —
# or replace the store implementation in src/lib/leads/store.ts.
LEADS_DB_PATH=

# Notifications. Tried in order: webhook, then Resend, then the server log.
# A webhook is the quickest route to Slack, Teams or a Zapier/Make workflow.
LEADS_WEBHOOK_URL=

# Resend (https://resend.com) — transactional email for new-lead alerts.
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=janeevan.john@fiatlaw.co.uk
LEADS_FROM_EMAIL=notifications@fiatlaw.co.uk
