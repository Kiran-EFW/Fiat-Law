# ---------------------------------------------------------------------------
# Fiat Law — environment
# Copy to .env.local for development, and set the same keys in the host's
# environment for production. Nothing here has a safe default in production
# except LEADS_DB_PATH.
# ---------------------------------------------------------------------------

# Admin console (/admin) — HTTP Basic auth.
# If ADMIN_PASSWORD is unset, /admin returns 503 in production and is open in
# development. Set a long random password before deploying.
ADMIN_USER=fiat
ADMIN_PASSWORD=

# Where the SQLite lead database lives. Defaults to ./data/leads.db.
# On a platform with an ephemeral filesystem, point this at a mounted volume —
# or replace the store implementation in src/lib/leads/store.ts.
LEADS_DB_PATH=

# Notifications. Tried in order: webhook, then Resend, then the server log.
# A webhook is the quickest route to Slack, Teams or a Zapier/Make workflow.
LEADS_WEBHOOK_URL=

# Resend (https://resend.com) — transactional email for new-lead alerts.
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=janeevan.john@fiatlaw.co.uk
LEADS_FROM_EMAIL=notifications@fiatlaw.co.uk

# ---------------------------------------------------------------------------
# Scalix — the deployed platform. See VISION.md §4.
#
# SCALIX_API_KEY must be a PROJECT-scoped key. An org-wide key cannot run SQL
# against Nova: the gateway answers `this operation requires a project-scoped
# API key` even with an X-Scalix-Project header, and MCP tools refuse it
# outright. Keys are minted in the console (Org → API Keys) while signed in —
# an API key cannot create another key.
#
# Create the key with database:read and database:query only. The lead store
# writes and reads; it never needs database:admin, which is what applying the
# schema once with scripts/nova-migrate.mjs requires.
# ---------------------------------------------------------------------------
SCALIX_API_KEY=
# Leave unset for the default gateway. Overriding it is how you point a build
# or a local process at a different Scalix deployment.
SCALIX_API_URL=

# Which lead store to use. "nova" is the deployed driver and "sqlite" the local
# one. Unset means: infer from whether SCALIX_API_KEY is present. Set it
# explicitly in production — leaving the driver to be inferred by a
# credential's presence is not a safe place to leave the decision.
LEADS_DRIVER=nova

# "production" or "preview". This is a BUILD decision, not a runtime one:
# robots.txt and every page's <head> are generated during `next build`, so
# whether the site invites indexing is frozen into the image. A preview must
# ask for it at build time; flipping it on a running service would make an
# indexable site that still throws its enquiries away.
SITE_ENV=production
